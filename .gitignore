# Environment and credential security
.env
.env.*
!.env.example
# environment.ts is a safe stub committed for tsc resolution (no real values)
# environment.prod.ts is NEVER committed — generated by scripts/generate-env.js at build time
!/src/environments/environment.ts
/src/environments/environment.prod.ts
!/src/environments/environment.template.ts
